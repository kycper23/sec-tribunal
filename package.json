{
  "name": "orbio-starter",
  "version": "0.1.0",
  "private": true,
  "description": "An example of building on an Orbio key. Not required reading, not a required stack.",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "chat": "tsx src/examples/01-chat.ts",
    "tools": "tsx src/examples/02-tools.ts",
    "structured": "tsx src/examples/03-structured.ts",
    "search": "tsx src/examples/04-web-search.ts",
    "image": "tsx src/examples/05-image.ts",
    "pdf": "tsx src/examples/06-pdf.ts",
    "agent": "tsx src/examples/07-agent.ts",
    "tribunal": "tsx src/tribunal/index.ts",
    "gen-assets": "tsx src/gen-assets.ts",
    "precompute": "tsx src/tribunal/precompute.ts",
    "backtest": "tsx src/tribunal/backtest.ts",
    "brief": "tsx src/sec/preview.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "next": "^16.3.5",
    "openai": "^5.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.35.0",
    "sharp": "^0.35.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
