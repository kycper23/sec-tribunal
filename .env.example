# Your Orbio key. Claim it on orbio.so or through the Orbio MCP (orbio_claim_key).
# It is an OpenRouter-compatible key routed through the Orbio gateway.
OPENROUTER_API_KEY=
# Alternative name accepted as a fallback (some Orbio setup scripts export this instead).
OPENAI_API_KEY=
# Orbio gateway base URL. Leave unset to use it; override only if you switch to raw OpenRouter.
OPENAI_BASE_URL=https://api.orbio.so/api/v1

# Optional. Any model on openrouter.ai/models; `openrouter/auto` lets the router pick.
# SEC Tribunal defaults to anthropic/claude-fable-5 if unset (see src/tribunal/agents.ts).
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1

# Optional. Shown on OpenRouter's public rankings for your app.
APP_NAME=Orbio Build Week
APP_URL=https://orbio.so/build
